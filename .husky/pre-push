#!/usr/bin/env sh
# Pre-push guard against accidental pushes to protected branches.
#
# Aborts the push if any ref being pushed targets a protected branch
# (master, main). Set ALLOW_MASTER_PUSH=1 in the environment to bypass
# this guard for a one-off intentional push.
#
# Hook contract: git pre-push hook reads lines of the form
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# from stdin, one per ref being pushed.

PROTECTED_BRANCHES="refs/heads/master refs/heads/main"

if [ "${ALLOW_MASTER_PUSH:-0}" = "1" ]; then
  echo "[pre-push] ALLOW_MASTER_PUSH=1 set — skipping protected-branch guard."
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      echo ""
      echo "\033[0;31m[pre-push] BLOCKED: refusing to push to $remote_ref\033[0m"
      echo "  local:  $local_ref ($local_sha)"
      echo "  remote: $remote_ref"
      echo ""
      echo "Protected branches ($PROTECTED_BRANCHES) require an explicit override."
      echo "If this push is intentional, re-run with:"
      echo "  ALLOW_MASTER_PUSH=1 git push ..."
      echo ""
      blocked=1
      ;;
  esac
done

if [ "$blocked" = "1" ]; then
  exit 1
fi

exit 0
