# Aria ERP - Production Environment Configuration
# This file contains environment variables for PRODUCTION deployment
# IMPORTANT: Replace all placeholder values with secure production values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database password
# REQUIRED: Generate a strong random password
# Suggestion: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Database URL (used by Prisma and backend)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://aria:CHANGE_THIS_TO_A_STRONG_PASSWORD@postgres:5432/aria

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis password (highly recommended for production)
# REQUIRED: Generate a strong random password
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD

# Redis URL (used by backend for caching/sessions)
REDIS_URL=redis://redis:6379

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Application environment
NODE_ENV=production

# Backend server port
PORT=3001

# JWT secret key for authentication
# CRITICAL: Generate a secure random key - never use default value
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING

# JWT token expiration time
# Recommended: shorter for production (e.g., 8h, 12h)
JWT_EXPIRATION=12h

# JWT refresh token expiration
JWT_REFRESH_EXPIRATION=7d

# CORS allowed origins (comma-separated)
# REQUIRED: Specify your actual domain(s)
# Example: https://erp.yourcompany.com,https://app.yourcompany.com
CORS_ORIGIN=https://YOUR_DOMAIN.com

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API URL for frontend to connect to backend
# REQUIRED: Set to your actual production domain
# Example: https://erp.yourcompany.com/api
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN.com/api

# Next.js telemetry (disable for privacy)
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# REVERSE PROXY CONFIGURATION (CADDY)
# ============================================================================

# Domain name for your production deployment
# REQUIRED: Set to your actual domain or server IP
# Examples:
#   - For domain: erp.yourcompany.com
#   - For IP: 192.168.1.100
#   - For localhost: localhost (will use self-signed cert)
DOMAIN=YOUR_DOMAIN.com

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

# Certificate email (for Let's Encrypt if using public domain)
# REQUIRED if using a public domain name
SSL_EMAIL=admin@YOUR_DOMAIN.com

# ============================================================================
# LOGGING AND MONITORING
# ============================================================================

# Log level (info, warn, error - avoid debug in production)
LOG_LEVEL=info

# Enable debug mode (set to false for production)
DEBUG=false

# Sentry DSN for error tracking (optional but recommended)
SENTRY_DSN=

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Maximum requests per window
RATE_LIMIT_MAX=1000

# Rate limit window in minutes
RATE_LIMIT_WINDOW=1

# Enable request logging
REQUEST_LOGGING_ENABLED=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application version (for deployment tracking)
VERSION=1.0.0

# Maximum upload file size (in bytes)
MAX_UPLOAD_SIZE=10485760

# Session cookie settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict

# ============================================================================
# BACKUP CONFIGURATION (Optional)
# ============================================================================

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention days
BACKUP_RETENTION_DAYS=30

# ============================================================================
# RESOURCE LIMITS (Optional - for container orchestration)
# ============================================================================

# Backend memory limit
BACKEND_MEMORY_LIMIT=2G

# Frontend memory limit
FRONTEND_MEMORY_LIMIT=2G

# Database memory limit
DB_MEMORY_LIMIT=2G

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure you have:
# 
# [ ] Changed POSTGRES_PASSWORD to a strong random password
# [ ] Changed REDIS_PASSWORD to a strong random password
# [ ] Changed JWT_SECRET to a cryptographically secure random string
# [ ] Set DOMAIN to your actual domain or server IP
# [ ] Set CORS_ORIGIN to your actual domain(s)
# [ ] Set NEXT_PUBLIC_API_URL to your actual API URL
# [ ] Set LOG_LEVEL to info or warn (not debug)
# [ ] Set DEBUG to false
# [ ] Configured SSL_EMAIL if using public domain
# [ ] Reviewed all security settings
# [ ] Set up regular backups
# [ ] Configured monitoring and alerting
# [ ] Tested the deployment in staging environment
# 
# ============================================================================
# NOTES
# ============================================================================
# 1. This is a PRODUCTION configuration template
# 2. Copy this file to .env and fill in all required values
# 3. Never commit .env files with real credentials to version control
# 4. Store production secrets securely (e.g., in a password manager)
# 5. Rotate passwords and secrets regularly
# 6. Use strong, unique passwords for each service
# 7. Review security settings before going live
