# Aria ERP - Production Environment Configuration
# This template configures the self-hosted production Compose stack.
# Copy it to .env.production, replace every placeholder, and pass it with:
# docker compose --env-file .env.production -f docker-compose.production.yml ...
# IMPORTANT: Never commit the completed .env.production file.

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database password. Use URL-safe characters because Compose builds
# the backend DATABASE_URL from this value.
# REQUIRED. Suggestion: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Self-hosted Compose derives DATABASE_URL from POSTGRES_PASSWORD. For Railway
# or another managed platform, set DATABASE_URL to that platform's PostgreSQL
# service-reference URL instead of using the value below.
# DATABASE_URL=postgresql://aria:CHANGE_THIS_TO_A_STRONG_PASSWORD@postgres:5432/aria

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis password used by the self-hosted Redis container.
# REQUIRED. Suggestion: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD

# Redis URL used by BullMQ. Keep it aligned with REDIS_PASSWORD; URL-encode
# password characters if they are not URL-safe.
REDIS_URL=redis://:CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD@redis:6379

# Required IANA timezone for business-date, midnight discovery, and startup
# reconciliation. Use a business timezone such as Asia/Kolkata, not an offset.
APP_TIME_ZONE=Asia/Kolkata

# BullMQ depreciation worker and reporting controls.
ASSET_DEPRECIATION_QUEUE_CONCURRENCY=5
ASSET_DEPRECIATION_BARRIER_TIMEOUT_MS=120000
ASSET_DEPRECIATION_QUEUE_OPERATION_TIMEOUT_MS=5000
ASSET_DEPRECIATION_RECONCILIATION_INTERVAL_MS=900000

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Better Auth signing secret
# CRITICAL: Required in production
BETTER_AUTH_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING

# ============================================================================
# FRONTEND CONFIGURATION (also drives CORS automatically)
# ============================================================================

# Frontend origin(s) used by backend for CORS and Better Auth trusted origins.
# Comma-separated list if you have multiple origins (e.g., web + mobile).
# Example: https://erp.yourcompany.com,https://app.yourcompany.com
FRONTEND_URL=https://YOUR_DOMAIN.com

# Public backend URL used by Better Auth. For self-hosted Compose this normally
# matches FRONTEND_URL because Caddy provides same-origin routing.
BETTER_AUTH_URL=https://YOUR_DOMAIN.com

# Self-hosted Compose builds the frontend with same-origin requests, so this
# root value is not used. Configure NEXT_PUBLIC_API_URL only as a build-time
# value when deploying the frontend against a separate backend domain.
NEXT_PUBLIC_API_URL=

# Initial administrator. Set all three values together only to bootstrap the
# first account; they are not required after that account exists. Rotate the
# password after the first login.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@YOUR_DOMAIN.com
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Demo data is never loaded at startup. On a disposable demo database only,
# run the explicit one-time command documented in docs/05-deployment/README.md
# with ARIA_ALLOW_DEMO_DATA_MUTATION=true and
# ARIA_DEMO_DATABASE_ISOLATED=true. Never add either confirmation to a shared
# production environment.

# ============================================================================
# REVERSE PROXY CONFIGURATION (CADDY)
# ============================================================================

# Domain name for your production deployment
# REQUIRED: Set to your actual domain or server IP
# Examples:
#   - For domain: erp.yourcompany.com
#   - For IP: 192.168.1.100
#   - For localhost: localhost (will use self-signed cert)
DOMAIN=YOUR_DOMAIN.com

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

# Application version (for deployment tracking)
VERSION=1.0.0

# Grafana is exposed by the monitoring stack. Change both defaults before
# publishing the deployment network.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure you have:
# 
# [ ] Changed POSTGRES_PASSWORD to a strong random password
# [ ] Changed REDIS_PASSWORD to a strong random password
# [ ] Changed BETTER_AUTH_SECRET to a cryptographically secure random string
# [ ] Set APP_TIME_ZONE to the company's IANA business timezone
# [ ] Set DOMAIN to your actual domain or server IP
# [ ] Set FRONTEND_URL to your actual domain(s) (CORS is derived automatically)
# [ ] Set BETTER_AUTH_URL to the public backend URL
# [ ] Set the three initial-admin values only when bootstrapping the first account
# [ ] Loaded demo data only through the explicit one-time command, if required
# [ ] Changed GRAFANA_ADMIN_PASSWORD or disabled external Grafana access
# [ ] Taken and restore-tested a PostgreSQL backup
# [ ] Validated Compose with `docker compose --env-file .env.production -f docker-compose.production.yml config --quiet`
# [ ] Confirmed https://YOUR_DOMAIN/health/ready returns 200 after deployment
# 
# ============================================================================
# NOTES
# ============================================================================
# 1. This is a PRODUCTION configuration template
# 2. Copy this file to .env.production and fill in all required values
# 3. Never commit .env files with real credentials to version control
# 4. Store production secrets securely (e.g., in a password manager)
# 5. Rotate passwords and secrets regularly
# 6. Use strong, unique passwords for each service
# 7. See docs/05-deployment/README.md and the depreciation production runbook
#    before going live
