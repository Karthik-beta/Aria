{
	"name": "aria",
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"scripts": {
		"predev": "bun x turbo run build --filter=@aria/types --filter=@aria/utils",
		"build": "bun x turbo run build",
		"dev": "bun --env-file=.env.development x turbo run dev",
		"predev:full": "bun x turbo run build --filter=@aria/types --filter=@aria/utils",
		"dev:full": "bun --env-file=.env.development x turbo run dev db:studio --concurrency=100%",
		"clean": "bun x turbo run clean",
		"lint": "bun x turbo run lint",
		"lint:fix": "bun x turbo run lint:fix",
		"lint:staged": "biome check --staged --write --files-ignore-unknown=true --no-errors-on-unmatched",
		"test:e2e": "bun x turbo run test:e2e --continue",
		"typecheck": "bun x turbo run typecheck",
		"test": "bun x turbo run test",
		"test:integration": "bun x turbo run test:integration",
		"prepare": "husky",
		"validate": "bun x turbo run build test lint typecheck --continue",
		"validate:fix": "bun x turbo run build test lint:fix typecheck --continue",
		"validate:local": "bun x turbo run lint typecheck test --continue"
	},
	"trustedDependencies": [
		"@prisma/client",
		"prisma"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@nodelib/fs.walk": "^3.0.1",
		"husky": "^9.1.7",
		"prisma": "^7.2.0",
		"rimraf": "^6.1.3",
		"turbo": "^2.8.20"
	},
	"packageManager": "bun@1.3.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"xlsx": "^0.18.5"
	}
}
