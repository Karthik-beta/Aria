{
	"name": "aria",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"predev": "bun x turbo run build --filter=@aria/types --filter=@aria/utils",
		"build": "turbo run build",
		"dev": "bun x turbo run dev",
		"dev:full": "turbo run dev db:start studio --parallel",
		"clean": "turbo run clean",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"lint:staged": "biome check --staged --write",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"prepare": "husky"
	},
	"trustedDependencies": [
		"@prisma/client",
		"prisma"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@nodelib/fs.walk": "^3.0.1",
		"husky": "^9.1.7",
		"prisma": "^7.2.0",
		"rimraf": "^6.1.3",
		"turbo": "^2.8.16"
	},
	"packageManager": "bun@1.3.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
