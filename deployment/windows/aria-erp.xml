<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Windows Service Configuration for Aria ERP
  This configuration is used with WinSW (Windows Service Wrapper)
  Download WinSW from: https://github.com/winsw/winsw/releases
-->
<service>
  <!-- Service identification -->
  <id>AriaERP</id>
  <name>Aria ERP</name>
  <description>Aria ERP Application Service - Manages Docker containers for the ERP system</description>
  
  <!-- Executable configuration -->
  <executable>docker</executable>
  <arguments>compose -f docker-compose.production.yml up</arguments>
  
  <!-- Working directory -->
  <workingdirectory>C:\aria</workingdirectory>
  
  <!-- Service startup configuration -->
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  
  <!-- Stop configuration -->
  <stopexecutable>docker</stopexecutable>
  <stoparguments>compose -f docker-compose.production.yml down</stoparguments>
  <stoptimeout>120 sec</stoptimeout>
  
  <!-- Environment variables -->
  <env name="NODE_ENV" value="production"/>
  <env name="COMPOSE_PROJECT_NAME" value="aria"/>
  
  <!-- Load environment from .env file -->
  <envfile>C:\aria\.env</envfile>
  
  <!-- Failure actions -->
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 day</resetfailure>
  
  <!-- Logging configuration -->
  <log mode="roll-by-time">
    <pattern>yyyy-MM-dd</pattern>
    <logpath>C:\aria\logs</logpath>
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>30</keepFiles>
  </log>
  
  <!-- Security settings -->
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalSystem</user>
  </serviceaccount>
  
  <!-- Priority configuration -->
  <priority>Normal</priority>
  
  <!-- Interactive services (set to false for security) -->
  <interactive>false</interactive>
  
  <!-- Auto-refresh -->
  <autoRefresh>true</autoRefresh>
</service>
