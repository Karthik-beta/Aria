# Aria ERP - Local Docker demo environment (preloaded)
#
# Used by docker-compose.local.yml and aria-local.ps1. Every value here is a
# throwaway default for a single-machine demo on http://localhost.
# Do NOT reuse these values for any shared or internet-facing deployment.

# ----------------------------------------------------------------------------
# Compose project / public URL
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aria-local

# Host port Caddy listens on. aria-local.ps1 -Port <n> overrides this.
ARIA_HTTP_PORT=8080
# Must match the URL you open in the browser (include :port when not 80).
ARIA_PUBLIC_URL=http://localhost:8080

# Registry with the prebuilt images (.github/workflows/release-images.yml).
# aria-local.ps1 -FromSource builds locally instead.
ARIA_IMAGE_REGISTRY=ghcr.io/karthik-beta

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_DB=aria
POSTGRES_USER=aria
POSTGRES_PASSWORD=aria_local_demo_pg
# Host port for DB tools (pgAdmin, DBeaver, psql). Bound to 127.0.0.1 only.
ARIA_POSTGRES_PORT=5433

# ----------------------------------------------------------------------------
# Redis (BullMQ depreciation queue)
# ----------------------------------------------------------------------------
REDIS_PASSWORD=aria_local_demo_redis

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_TIME_ZONE=Asia/Kolkata
ASSET_DEPRECIATION_QUEUE_CONCURRENCY=5
ASSET_DEPRECIATION_BARRIER_TIMEOUT_MS=300000

# Better Auth signing secret (local demo only, 64 hex chars)
BETTER_AUTH_SECRET=4f1c2a9e7b3d58a06e2f91c4d7b0a3e85c6f19d2a7e40b3c8d5f62e1a9b07c4d

# Default super admin created by the backend on first start
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@aria.local
DEFAULT_ADMIN_NAME=Administrator

# Default organization created by the backend on first start
DEFAULT_ORG_NAME=Pivotr Technologies
DEFAULT_ORG_SLUG=pivotr

# ----------------------------------------------------------------------------
# Demo data
# ----------------------------------------------------------------------------
# Loaded once into a fresh database before the backend starts.
# true | false
DEMO_DATA_ENABLED=true
# small | medium | large  (small takes a few minutes, large can take much longer)
DEMO_DATA_SCALE=medium

# ----------------------------------------------------------------------------
# Scheduled backups (backup service, written to deployment/local/backups)
# ----------------------------------------------------------------------------
# Cron expression in APP_TIME_ZONE (default: every night at 02:00)
BACKUP_SCHEDULE=0 2 * * *
# Number of nightly backups to keep (manual and pre-restore backups are kept;
# update removes its pre-update restore point once the update succeeds)
BACKUP_RETENTION=7
