# Aria ERP Production Environment Configuration Template
# Copy this file to .env and configure for your environment

# ============================================
# REQUIRED: Database Configuration
# ============================================
POSTGRES_DB=aria
POSTGRES_USER=aria
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_NOW

# ============================================
# APPLICATION CONFIGURATION
# ============================================
VERSION=latest
NODE_ENV=production

# ============================================
# LOG MANAGEMENT CONFIGURATION
# ============================================

# Docker Container Logging
# Maximum size of each log file before rotation
# Examples: 10m (10 megabytes), 100m, 1g
LOG_MAX_SIZE=10m

# Number of rotated log files to keep per container
# Docker will keep this many old log files
LOG_MAX_FILES=3

# Application Log Retention
# Number of days to keep application logs before deletion
# Used by log rotation scripts (rotate-logs-*.sh/ps1)
LOG_RETENTION_DAYS=30

# Log Compression
# Enable compression of rotated log files to save disk space
# Used by log rotation scripts (rotate-logs-*.sh/ps1)
LOG_COMPRESS_ENABLED=true

# ============================================
# NOTES
# ============================================
# 
# LOG ROTATION OVERVIEW:
# ----------------------
# This deployment uses a two-layer log management approach:
#
# 1. Docker Container Logs (LOG_MAX_SIZE, LOG_MAX_FILES):
#    - Automatically managed by Docker daemon
#    - Controls size and number of container stdout/stderr logs
#    - Logs stored in Docker's internal directory
#    - No manual intervention needed
#
# 2. Application File Logs (LOG_RETENTION_DAYS, LOG_COMPRESS_ENABLED):
#    - Written to ./logs/ directory by applications
#    - Managed by rotation scripts (rotate-logs-*.sh/ps1)
#    - Schedule scripts via cron (Linux) or Task Scheduler (Windows)
#
# RECOMMENDED CRON SCHEDULE (Linux):
# Run daily at 2 AM:
#   0 2 * * * /opt/aria-erp/scripts/rotate-logs-linux.sh
#
# RECOMMENDED TASK SCHEDULER (Windows):
# Run daily at 2 AM:
#   Action: Start a program
#   Program: powershell.exe
#   Arguments: -ExecutionPolicy Bypass -File "C:\aria-erp\scripts\rotate-logs-windows.ps1"
#
# DISK SPACE ESTIMATES (per 200 users):
# - Without rotation: ~10GB per month
# - With rotation (30 days): ~1-2GB steady state
# - With compression: ~500MB-1GB steady state
