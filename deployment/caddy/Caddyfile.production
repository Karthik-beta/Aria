# Caddy Configuration for Production Environment
# Supports HTTP/HTTPS/HTTP/3 with automatic SSL and security headers

{
    # Global server configuration
    servers {
        # Enable HTTP/3 support
        protocols h1 h2 h3
    }
    
    # Automatic HTTPS configuration
    # Use disable_redirects to allow local self-signed certificates
    auto_https disable_redirects
    
    # Use local certificates for private networks
    # Caddy will generate self-signed certs for IP addresses
    local_certs
    
    # Admin API (only accessible locally)
    admin localhost:2019
}

# Main application configuration
# Use environment variable for domain or default to localhost
{$DOMAIN:localhost} {
	# Routing configuration with priority
	route {
		# Health check endpoint (direct access)
		respond /health 200 {
			body "OK"
			close
		}

		# API routes to backend (including auth at /api/auth/*)
		reverse_proxy /api/* backend:3001 {
			# Load balancing (single backend for now, ready for horizontal scaling)
			lb_policy round_robin
			lb_try_duration 30s

			# Active health checking
			health_uri /health
			health_interval 30s
			health_timeout 10s
			health_status 200

			# Passive health checking
			fail_duration 30s
			max_fails 3
			unhealthy_status 500 502 503 504

			# Request timeout
			flush_interval -1
		}

		# tRPC routes to backend
		reverse_proxy /trpc/* backend:3001 {
			health_uri /health
			health_interval 30s
		}

		# tRPC WebSocket support for real-time subscriptions
		@websocket {
			path /trpc-ws
			header Connection *Upgrade*
			header Upgrade websocket
		}
		handle @websocket {
			reverse_proxy backend:3001
		}

		# Frontend routes (Next.js production)
		reverse_proxy frontend:3000 {
			# Request buffering for better performance
			flush_interval 1s
		}
	}
    
    # Security headers (comprehensive protection)
    header {
        # HSTS - Force HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        
        # Prevent clickjacking
        X-Frame-Options "DENY"
        
        # XSS Protection (legacy browsers)
        X-XSS-Protection "1; mode=block"
        
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Content Security Policy (relaxed for debugging)
        # TODO: Tighten this after auth issues are resolved
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://localhost http://localhost; frame-ancestors 'none';"
        
        # Permissions policy (restrict browser features)
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        
        # Remove server identification
        -Server
        -X-Powered-By
    }
    
    # Compression for better performance
    encode {
        gzip 6
        zstd
        minimum_length 256
    }
    
    # Production logging (JSON format for parsing)
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level INFO
    }
    
    # Error logging
    log {
        output file /var/log/caddy/error.log {
            roll_size 50MB
            roll_keep 5
        }
        format json
        level ERROR
    }
}

# Redirect HTTP to HTTPS for production domain
http://{$DOMAIN:localhost} {
    redir https://{host}{uri} permanent
}
