# Caddy Configuration for Development Environment
# This file is for local development only - no SSL, simple routing

{
    # Disable automatic HTTPS for development
    auto_https off
    
    # Enable admin API on localhost
    admin localhost:2019
    
    # Enable debug logging
    debug
}

# Development server on HTTP
:80 {
    # Routing configuration
    route {
        # API and tRPC routes to backend
        reverse_proxy /api/* backend:3001
        reverse_proxy /trpc/* backend:3001
        
        # tRPC WebSocket endpoint (critical for tRPC subscriptions)
        # Caddy automatically handles WebSocket upgrade headers
        # See: https://trpc.io/docs/server/websockets
        reverse_proxy /trpc-ws backend:3001
        
        # WebSocket support for Next.js hot-reload (HMR)
        # Must route to frontend:3000 where Next.js dev server runs
        reverse_proxy /ws frontend:3000 {
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
        
        # Frontend routes (Next.js dev server)
        reverse_proxy frontend:3000 {
            # Support Next.js HMR
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }
    
    # Development logging (verbose)
    log {
        output stdout
        format console
        level DEBUG
    }
    
    # Basic compression
    encode gzip
}
