{
	"$schema": "https://turborepo.com/schema.json",
	"remoteCache": {
		"enabled": true
	},
	"globalDependencies": [
		"biome.json",
		"bun.lock",
		"package.json",
		"tsconfig.base.json",
		"apps/*/tsconfig*.json",
		"packages/*/tsconfig*.json",
		"packages/config-typescript/*.json"
	],
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"SENTRY_AUTH_TOKEN",
		"SENTRY_ORG",
		"SENTRY_PROJECT"
	],
	"globalEnv": [
		"APP_TIME_ZONE",
		"BACKEND_URL",
		"NEXT_PUBLIC_API_URL",
		"NODE_ENV"
	],
	"tasks": {
		"clean": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"passThroughEnv": ["SENTRY_AUTH_TOKEN", "SENTRY_ORG", "SENTRY_PROJECT"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!docs/**",
				"!**/*.md",
				"!**/*.mdx",
				"!**/lint-output.txt",
				"!**/temp-*.txt",
				"!**/*.tsbuildinfo",
				"!**/coverage/**",
				"!**/playwright-report/**",
				"!**/.next/cache/**",
				"!**/.next/dev/**",
				"!**/test-results/**",
				"!**/tmp-typecheck/**",
				"!**/target/**",
				"!**/.errors/**",
				"!**/test/**/out/**",
				"!**/test/**/next-env.d.ts",
				"!**/test/**/.next*",
				"!**/test/tmp/**",
				"!**/test/.trace",
				"!**/test/traces",
				"!**/pr-stats.md",
				"!**/test-timings.json",
				"!**/.vercel/**",
				"!**/.now/**",
				"!**/.swc/**",
				"!**/examples/**/out/**",
				"!**/.conductor/**",
				"!index.scip",
				"!**/evals/**"
			],
			"outputs": [
				"dist/**",
				"build/**",
				".next/**",
				"!.next/cache/**",
				"!.next/dev/**"
			],
			"cache": true
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!docs/**",
				"!**/*.md",
				"!**/*.mdx",
				"!**/lint-output.txt",
				"!**/temp-*.txt",
				"!**/*.tsbuildinfo",
				"!**/coverage/**",
				"!**/playwright-report/**",
				"!**/.next/cache/**",
				"!**/.next/dev/**",
				"!**/test-results/**",
				"!**/tmp-typecheck/**",
				"!**/target/**",
				"!**/.errors/**",
				"!**/test/**/out/**",
				"!**/test/**/next-env.d.ts",
				"!**/test/**/.next*",
				"!**/test/tmp/**",
				"!**/test/.trace",
				"!**/test/traces",
				"!**/pr-stats.md",
				"!**/test-timings.json",
				"!**/.vercel/**",
				"!**/.now/**",
				"!**/.swc/**",
				"!**/examples/**/out/**",
				"!**/.conductor/**",
				"!index.scip",
				"!**/evals/**"
			],
			"outputs": [],
			"cache": true
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"db:studio": {
			"persistent": true,
			"cache": false
		},
		"db:migrate:deploy": {
			"cache": false
		},
		"demo:load:small": {
			"cache": false
		},
		"start": {
			"dependsOn": ["^build"],
			"persistent": true,
			"cache": false
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!docs/**",
				"!**/*.md",
				"!**/*.mdx",
				"!**/lint-output.txt",
				"!**/temp-*.txt",
				"!**/*.tsbuildinfo",
				"!**/coverage/**",
				"!**/playwright-report/**",
				"!**/.next/cache/**",
				"!**/.next/dev/**",
				"!**/test-results/**",
				"!**/tmp-typecheck/**",
				"!**/target/**",
				"!**/.errors/**",
				"!**/test/**/out/**",
				"!**/test/**/next-env.d.ts",
				"!**/test/**/.next*",
				"!**/test/tmp/**",
				"!**/test/.trace",
				"!**/test/traces",
				"!**/pr-stats.md",
				"!**/test-timings.json",
				"!**/.vercel/**",
				"!**/.now/**",
				"!**/.swc/**",
				"!**/examples/**/out/**",
				"!**/.conductor/**",
				"!index.scip",
				"!**/evals/**"
			],
			"outputs": []
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build", "prisma:generate"],
			"outputs": []
		},
		"test:e2e": {
			"cache": false
		},
		"test:integration": {
			"dependsOn": ["^build", "prisma:generate"],
			"cache": false
		},
		"test:depreciation:unit": {
			"dependsOn": ["^build", "prisma:generate"],
			"outputs": []
		},
		"test:depreciation:integration": {
			"dependsOn": ["^build", "prisma:generate"],
			"cache": false
		},
		"test:depreciation:migrations": {
			"dependsOn": ["prisma:generate"],
			"cache": false
		},
		"depreciation:preflight": {
			"cache": false
		},
		"prisma:generate": {
			"outputs": ["src/generated/prisma/**"],
			"cache": true
		},
		"package": {
			"dependsOn": ["build"],
			"outputs": ["dist/**"],
			"cache": true
		}
	}
}
