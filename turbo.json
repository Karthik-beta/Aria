{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [],
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "db:start": {
      "persistent": true,
      "cache": false
    },
    "studio": {
      "persistent": true,
      "cache": false
    },
    "start": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"],
      "cache": false
    }
  }
}
