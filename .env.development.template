# Aria ERP - Development Environment Configuration
# This file contains environment variables for LOCAL DEVELOPMENT only
# DO NOT use these values in production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database password (development only)
POSTGRES_PASSWORD=dev_password_change_me

# Database URL (used by Prisma and backend)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://aria_dev:dev_password_change_me@postgres:5432/aria_dev

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis password (optional for development)
REDIS_PASSWORD=

# Redis URL (used by backend for caching/sessions)
REDIS_URL=redis://redis:6379

# Required IANA timezone for business-date and midnight depreciation discovery
APP_TIME_ZONE=UTC
ASSET_DEPRECIATION_QUEUE_CONCURRENCY=5
ASSET_DEPRECIATION_BARRIER_TIMEOUT_MS=120000

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Application environment
NODE_ENV=development

# Backend server port
PORT=3001

# Better Auth signing secret and public backend URL
BETTER_AUTH_SECRET=dev_better_auth_secret_change_in_production
BETTER_AUTH_URL=http://localhost:3001

# Frontend origin(s) used by backend for CORS and Better Auth trusted origins.
# In development, localhost is the default. Use comma-separated list for multiple origins.
FRONTEND_URL=http://localhost:3000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API URL for frontend to connect to backend
# Development: http://localhost/api (through Caddy proxy)
NEXT_PUBLIC_API_URL=http://localhost/api

# Next.js telemetry (disable for privacy)
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# REVERSE PROXY CONFIGURATION
# ============================================================================

# Domain name (use localhost for development)
DOMAIN=localhost

# ============================================================================
# LOGGING AND MONITORING
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# Enable debug mode
DEBUG=true

# ============================================================================
# DEVELOPMENT-SPECIFIC SETTINGS
# ============================================================================

# Enable hot module replacement
WATCHPACK_POLLING=true

# Prisma logging
PRISMA_LOG_LEVEL=info

# ============================================================================
# NOTES
# ============================================================================
# 1. This is a DEVELOPMENT configuration - do not use in production
# 2. Copy this file to .env.local to customize for your local environment
# 3. Never commit .env.local or files with real credentials to version control
# 4. Generate strong passwords for production deployment
# 5. For production, use .env.production.template as a starting point
