# ============================================
# Aria ERP - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
DISABLE_AUTH=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
ENABLE_AUTH=true

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/aria_erp?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aria_erp

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Backend Configuration
# ============================================
BACKEND_URL=http://backend:3001
BACKEND_PORT=3001

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost/api
FRONTEND_PORT=3000

# ============================================
# NextAuth.js / Auth.js v5 Configuration
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-min-32-chars
AUTH_URL=http://localhost
AUTH_TRUST_HOST=true

# ============================================
# Zitadel Authentication (Self-Hosted)
# ============================================
# Zitadel Client Credentials (create application in Zitadel console)
# Auth.js v5 uses AUTH_ZITADEL_* prefix for provider configuration
AUTH_ZITADEL_ID=your-client-id-from-zitadel
AUTH_ZITADEL_SECRET=your-client-secret-from-zitadel
AUTH_ZITADEL_ISSUER=http://localhost

# Internal Docker network address (for backend)
ZITADEL_DOMAIN=http://zitadel:8080

# Default User for Development
DEFAULT_USER_EMAIL=admin@aria-erp.local
DEFAULT_USER_PASSWORD=admin

# ============================================
# Zitadel Database Configuration
# ============================================
# Note: Zitadel uses the main PostgreSQL instance
# Database and user are created automatically by Zitadel on first start
ZITADEL_DB_PASSWORD=zitadel-secure-password

# ============================================
# Zitadel Server Configuration
# ============================================
# Generate with: tr -dc A-Za-z0-9 </dev/urandom | head -c 32
# MUST be exactly 32 characters
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Character

# Organization name for Zitadel instance
ZITADEL_ORG_NAME=Aria

# First-time setup admin credentials
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=YourSecureAdminPassword123!

# ============================================
# Caddy Configuration
# ============================================
CADDY_DOMAIN=localhost

# ============================================
# Test Configuration
# ============================================
TEST_USER_EMAIL=admin@aria-erp.local
TEST_USER_PASSWORD=AdminSecure123!
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ============================================
# Security Notes
# ============================================
# 1. Generate strong random values for all secrets
# 2. Never commit .env file to version control
# 3. Use different credentials for each environment
# 4. Rotate secrets regularly
# 5. Use environment-specific secret management in production
