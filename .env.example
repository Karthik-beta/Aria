# ============================================
# Aria ERP - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
APP_TIME_ZONE=UTC

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/aria_erp?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aria_erp

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Durable fixed-asset depreciation processing
ASSET_DEPRECIATION_QUEUE_CONCURRENCY=5
ASSET_DEPRECIATION_BARRIER_TIMEOUT_MS=120000

# ============================================
# Backend Configuration
# ============================================
BACKEND_URL=http://backend:3001
BACKEND_PORT=3001

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost/api
FRONTEND_PORT=3000

# ============================================
# Better Auth Configuration
# ============================================
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Default User for Development
DEFAULT_USER_EMAIL=admin@aria-erp.local
DEFAULT_USER_PASSWORD=admin

# ============================================
# Organization Configuration
# ============================================
# The single organization name and slug for this deployment.
# Used by the backend on startup to create the default org if it doesn't exist.
DEFAULT_ORG_NAME=Aria ERP
DEFAULT_ORG_SLUG=aria-erp

# ============================================
# Caddy Configuration
# ============================================
CADDY_DOMAIN=localhost

# ============================================
# Test Configuration
# ============================================
TEST_USER_EMAIL=admin@aria-erp.local
TEST_USER_PASSWORD=AdminSecure123!
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ============================================
# Demo Data
# ============================================
# Container startup never loads demo data. Run this explicitly from
# apps/backend against a fresh demo database:
# bun run demo:load:small

# ============================================
# Security Notes
# ============================================
# 1. Generate strong random values for all secrets
# 2. Never commit .env file to version control
# 3. Use different credentials for each environment
# 4. Rotate secrets regularly
# 5. Use environment-specific secret management in production
