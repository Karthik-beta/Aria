{
	"extends": "@aria/tsconfig/nest.json",
	"compilerOptions": {
		"removeComments": true,
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"outDir": "./dist",
		"rootDir": "./src",
		"baseUrl": "./",
		"declaration": false,
		"declarationMap": false,
		"useUnknownInCatchVariables": false,
		"types": ["node", "jest"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "test", "src/generated/prisma/**/*.js"]
}
