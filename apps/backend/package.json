{
	"name": "backend",
	"version": "0.0.1",
	"private": true,
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./public-types": {
			"types": "./src/public-types.ts"
		}
	},
	"scripts": {
		"prebuild": "prisma generate",
		"build": "nest build",
		"format": "biome format --write .",
		"start": "node dist/main.js",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"pretypecheck": "prisma generate",
		"typecheck": "tsc --noEmit --pretty false",
		"pretest": "prisma generate",
		"test": "bun ./scripts/run-unit-tests.ts",
		"test:watch": "node ./node_modules/jest/bin/jest.js --watch",
		"test:cov": "node ./node_modules/jest/bin/jest.js --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "node ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"clean": "rimraf dist .test-dist .turbo node_modules"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"dependencies": {
		"@aria/types": "workspace:*",
		"@aria/utils": "workspace:*",
		"@nestjs/common": "^11.1.10",
		"@nestjs/core": "^11.1.10",
		"@nestjs/platform-express": "^11.1.10",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@trpc/server": "^11.8.1",
		"@types/ws": "^8.18.1",
		"@willsoto/nestjs-prometheus": "^6.0.2",
		"bcrypt": "^6.0.0",
		"better-auth": "^1.5.4",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"pg": "^8.16.3",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1",
		"ws": "^8.18.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.1.10",
		"@aria/api-contract": "workspace:*",
		"@aria/tsconfig": "workspace:*",
		"@types/bcrypt": "^5.0.2",
		"@cloudflare/workers-types": "^4.20260303.0",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.5",
		"@types/pg": "^8.11.10",
		"@types/supertest": "^6.0.2",
		"globals": "^15.14.0",
		"jest": "^29.7.0",
		"prisma": "^7.2.0",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3"
	}
}
