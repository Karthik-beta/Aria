{
	"name": "backend",
	"version": "0.0.1",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./public-types": {
			"types": "./src/public-types.ts"
		}
	},
	"scripts": {
		"prisma:generate": "bun x --bun prisma generate",
		"build": "bun x -p @nestjs/cli nest build",
		"format": "biome format --write .",
		"start": "node dist/main.js",
		"dev": "bun x -p @nestjs/cli nest start --watch",
		"start:debug": "bun x -p @nestjs/cli nest start --debug --watch",
		"start:prod": "node dist/main.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit --pretty false",
		"test": "bun ./scripts/run-unit-tests.ts",
		"test:integration": "bun run test:depreciation:integration",
		"test:depreciation:unit": "bun ./scripts/run-unit-tests.ts depreciation",
		"test:depreciation:integration": "bun ./scripts/run-unit-tests.ts depreciation.integration",
		"test:depreciation:migrations": "sh ./scripts/test-depreciation-migrations.sh",
		"depreciation:preflight": "bun ./scripts/depreciation-preflight.ts",
		"depreciation:queue": "bun ./scripts/depreciation-queue.ts",
		"test:watch": "node ./node_modules/jest/bin/jest.js --watch",
		"test:cov": "node ./node_modules/jest/bin/jest.js --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "node ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
		"db:migrate": "bun x --bun prisma migrate dev",
		"db:migrate:deploy": "bun ./scripts/deploy-migrations.ts",
		"db:push": "bun x --bun prisma db push",
		"db:studio": "bun x --bun prisma studio",
		"db:generate": "bun run prisma:generate",
		"db:seed": "bun x --bun prisma db seed",
		"db:reset": "bun x --bun prisma migrate reset --force",
		"demo:load:small": "bun prisma/demo-data/cli.ts load --scale=small",
		"clean": "rimraf dist .test-dist .turbo tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"moduleNameMapper": {
			"^(\\.{1,2}/.*)\\.js$": "$1"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"dependencies": {
		"@aria/report-export": "workspace:*",
		"@aria/types": "workspace:*",
		"@aria/utils": "workspace:*",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.1.10",
		"@nestjs/core": "^11.1.10",
		"@nestjs/event-emitter": "^3.1.0",
		"@nestjs/platform-express": "^11.1.10",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/terminus": "^11.0.0",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.5.0",
		"@trpc/server": "^11.8.1",
		"@types/ws": "^8.18.1",
		"@willsoto/nestjs-prometheus": "^6.0.2",
		"bcrypt": "^6.0.0",
		"better-auth": "^1.5.4",
		"bullmq": "^5.80.2",
		"cron": "^4.4.0",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"pg": "^8.16.3",
		"prisma": "^7.5.0",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1",
		"ws": "^8.18.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@aria/api-contract": "workspace:*",
		"@aria/tsconfig": "workspace:*",
		"@cloudflare/workers-types": "^4.20260303.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.1.10",
		"@types/bcrypt": "^5.0.2",
		"@types/bun": "^1.3.13",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.5",
		"@types/pg": "^8.11.10",
		"@types/supertest": "^6.0.2",
		"globals": "^15.14.0",
		"jest": "^29.7.0",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^7.0.2"
	}
}
