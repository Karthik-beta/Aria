{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/apps/backend/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "cd apps/backend && bun x --bun prisma migrate deploy"
    ],
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 600
  }
}