{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "/apps/backend/Dockerfile"
	},
	"deploy": {
		"preDeployCommand": ["bun --cwd=/app/apps/backend run db:migrate:deploy"],
		"healthcheckPath": "/health/ready",
		"healthcheckTimeout": 600,
		"numReplicas": 1
	}
}
