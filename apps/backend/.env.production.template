# Aria ERP Backend - Production Environment Variables Template
# Copy this file to .env.production and fill in the values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node environment (should be 'production')
NODE_ENV=production

# Application port
PORT=3001

# Application version/release (set by CI/CD)
VERSION=1.0.0

# Hostname for logging/monitoring
HOSTNAME=aria-backend-01

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://aria:CHANGE_ME_STRONG_PASSWORD@postgres:5432/aria?schema=public

# Database pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# JWT expiration time
JWT_EXPIRES_IN=7d

# Bcrypt rounds for password hashing (10-12 recommended)
BCRYPT_ROUNDS=12

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# =============================================================================
# RATE LIMITING
# =============================================================================

# Global rate limit (requests per minute)
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Strict rate limit for sensitive endpoints
RATE_LIMIT_STRICT_TTL=60000
RATE_LIMIT_STRICT_LIMIT=10

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry environment
SENTRY_ENVIRONMENT=production

# Sentry release (set by CI/CD)
SENTRY_RELEASE=${VERSION}

# Enable Sentry traces (true/false)
SENTRY_TRACES_ENABLED=true

# Sentry traces sample rate (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# OPENTELEMETRY (OPTIONAL)
# =============================================================================

# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# OpenTelemetry service name
OTEL_SERVICE_NAME=aria-backend

# OpenTelemetry traces sample rate
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================================================
# LOGGING
# =============================================================================

# Log level (error, warn, info, debug, verbose)
LOG_LEVEL=info

# Log format (json, pretty)
LOG_FORMAT=json

# Log file path (relative to app root)
LOG_FILE_PATH=./logs/app.log

# Max log file size
LOG_MAX_SIZE=10m

# Max log files to keep
LOG_MAX_FILES=3

# =============================================================================
# FILE UPLOADS
# =============================================================================

# Upload directory
UPLOAD_DIR=./uploads

# Max file size (in bytes, 10MB default)
MAX_FILE_SIZE=10485760

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# =============================================================================

# SMTP host
SMTP_HOST=smtp.gmail.com

# SMTP port
SMTP_PORT=587

# SMTP secure (true for 465, false for other ports)
SMTP_SECURE=false

# SMTP user
SMTP_USER=noreply@your-domain.com

# SMTP password
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Email from address
EMAIL_FROM=Aria ERP <noreply@your-domain.com>

# =============================================================================
# REDIS CONFIGURATION (OPTIONAL - for caching/sessions)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://redis:6379

# Redis password
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Redis database number
REDIS_DB=0

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable API documentation (Swagger)
ENABLE_API_DOCS=false

# Enable GraphQL playground
ENABLE_GRAPHQL_PLAYGROUND=false

# Enable debug endpoints
ENABLE_DEBUG_ENDPOINTS=false

# =============================================================================
# PERFORMANCE & OPTIMIZATION
# =============================================================================

# Enable compression
ENABLE_COMPRESSION=true

# Compression level (1-9, higher = better compression but slower)
COMPRESSION_LEVEL=6

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. NEVER commit this file with real secrets to version control
# 2. Use strong, unique passwords for all services
# 3. Rotate secrets regularly (every 90 days minimum)
# 4. Use environment-specific values for each deployment
# 5. Consider using a secrets management service (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. Validate all required variables are set before starting the application
# 
