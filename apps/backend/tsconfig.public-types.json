{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"composite": true,
		"outDir": "./dist-types",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"dist-types",
		"test",
		"src/**/*.spec.ts",
		"src/**/__tests__/**/*.ts"
	]
}
