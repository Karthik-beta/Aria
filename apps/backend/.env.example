# Backend Environment Variables

# Application
NODE_ENV=development
PORT=3001

# Database
# Prisma requires DATABASE_URL for connection
# For Docker development: use service name 'postgres'
DATABASE_URL=postgresql://aria_dev:dev_password_change_me@postgres:5432/aria_dev

# For local development (outside Docker): use 'localhost'
# DATABASE_URL=postgresql://aria_dev:dev_password_change_me@localhost:5432/aria_dev

# Legacy database environment variables (for reference)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aria_dev
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=aria_dev

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Frontend origin(s) used by backend for CORS and Better Auth trusted origins.
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Email (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aria-erp.com

# Redis (Optional - for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS (Optional - for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true
