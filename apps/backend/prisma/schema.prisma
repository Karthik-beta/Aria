// ============================================================================
// Prisma v7 Schema Configuration
// ============================================================================
//
// This schema uses Prisma ORM v7, which introduces a Rust-free architecture
// with significant changes from v6. Key differences:
//
// GENERATOR BLOCK:
// - `provider = "prisma-client"` replaces the old "prisma-client-js"
// - `output` is now REQUIRED (no longer generates to node_modules)
// - `moduleFormat` can be "esm" or "cjs" (use "cjs" for NestJS compatibility)
//
// DATASOURCE BLOCK:
// - `url` field is DEPRECATED - configure in prisma.config.ts instead
// - Only `provider` is required here
//
// @see https://www.prisma.io/docs/orm/more/upgrade-guides/upgrading-versions/upgrading-to-prisma-7
// ============================================================================

generator client {
  // Prisma v7 uses "prisma-client" instead of "prisma-client-js"
  // This enables the new Rust-free TypeScript-native query engine
  provider     = "prisma-client"
  
  // REQUIRED in v7: Custom output path for generated client
  // Import from: '../generated/prisma/client.js' (relative to src/)
  output       = "../src/generated/prisma"
  
  // Module format: "cjs" for CommonJS (NestJS), "esm" for ES Modules
  moduleFormat = "cjs"
}

datasource db {
  // Database provider - the connection URL is configured in prisma.config.ts
  // (The `url` field is deprecated in Prisma v7)
  provider = "postgresql"
}


model InventoryItem {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(100)

  itemGroup   ItemGroup? @relation(fields: [itemGroupId], references: [id])
  itemGroupId String?

  description        String?
  disabled           Boolean @default(false)
  maintainStock      Boolean @default(true)
  allowAlternateItem Boolean @default(false)
  hasVariants        Boolean @default(false)

  // Variant parent-child link (self-referencing)
  templateItemId String?
  templateItem   InventoryItem?  @relation("ItemVariants", fields: [templateItemId], references: [id], onDelete: SetNull)
  variants       InventoryItem[] @relation("ItemVariants")

  // Stock and pricing
  openingStock        Int    @default(0)
  valuationRate       Float?
  standardSellingRate Float?

  // Tax settings
  isZeroRated  Boolean @default(false)
  isExempt     Boolean @default(false)
  isFixedAsset Boolean @default(false)
  taxCode      String? @db.VarChar(50)

  // Inventory Settings
  shelfLifeInDays            Int?
  warrantyPeriodInDays       Int?
  endOfLife                  DateTime?
  weightPerUnit              Float?
  weightUom                  String?   @db.VarChar(50)
  allowNegativeStock         Boolean   @default(false)
  valuationMethod            String?   @db.VarChar(50)
  defaultMaterialRequestType String?   @db.VarChar(50)

  // Reorder / Procurement
  safetyStock                Float     @default(0)
  leadTimeDays               Int       @default(0)

  // Serial Nos and Batches
  hasBatchNo  Boolean @default(false)
  hasSerialNo Boolean @default(false)

  barcodes        ItemBarcode[]
  reorderSettings ItemReorder[]

  defaultUnitOfMeasureId String?
  defaultUnitOfMeasure   UnitOfMeasurement? @relation(fields: [defaultUnitOfMeasureId], references: [id])
  batches                Batch[]
  installationNoteItems  InstallationNoteItem[]
  serialNos              SerialNo[]
  itemAttributes         InventoryItemAttribute[]

  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([name])
  @@index([templateItemId])
  @@index([createdAt])
  @@map("inventory_items")
}

model ItemBarcode {
  id          String        @id @default(cuid())
  itemId      String
  barcode     String        @db.VarChar(255)
  barcodeType String?       @db.VarChar(100)
  uom         String?       @db.VarChar(50)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_barcodes")
}

model ItemReorder {
  id                  String        @id @default(cuid())
  itemId              String
  warehouse           String        @db.VarChar(255)
  reorderLevel        Float         @default(0)
  reorderQty          Float         @default(0)
  materialRequestType String?       @db.VarChar(100)
  item                InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_reorder_settings")
}

model InventoryItemAttribute {
  id             String        @id @default(cuid())
  itemId         String
  attributeId    String
  attributeValue String        @db.VarChar(255)
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute      ItemAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([itemId, attributeId])
  @@index([itemId])
  @@index([attributeId])
  @@map("inventory_item_attributes")
}


model ItemGroup {
  id              String             @id @default(cuid())
  groupName       String             @db.VarChar(255)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  parentId        String?
  isGroup         Boolean            @default(false)
  items           Item[]
  inventoryItems  InventoryItem[]
  defaults        ItemGroupDefault[]
  parentItemGroup ItemGroup?         @relation("ItemGroupHierarchy", fields: [parentId], references: [id])
  children        ItemGroup[]        @relation("ItemGroupHierarchy")
}

model ItemGroupDefault {
  id               String    @id @default(cuid())
  itemGroupId      String
  company          String    @db.VarChar(255)
  defaultWarehouse String?   @db.VarChar(255)
  defaultPriceList String?   @db.VarChar(255)
  itemGroup        ItemGroup @relation(fields: [itemGroupId], references: [id], onDelete: Cascade)

  @@map("item_group_defaults")
}

model StockSettings {
  id                                                     String   @id @default(cuid())
  singletonKey                                           String   @unique @default("default") @db.VarChar(32)
  itemNamingBy                                           String   @db.VarChar(50) @default("ITEM_CODE")
  defaultWarehouse                                       String?  @db.VarChar(255)
  defaultValuationMethod                                 String   @db.VarChar(50) @default("FIFO")
  defaultStockUom                                        String?  @db.VarChar(50)
  autoInsertItemPriceIfMissing                           Boolean  @default(false)
  updateExistingPriceListRate                            Boolean  @default(false)
  allowToEditStockUomQtyForSalesDocuments                Boolean  @default(false)
  allowToEditStockUomQtyForPurchaseDocuments             Boolean  @default(false)
  overDeliveryReceiptAllowancePercent                    Float    @default(0)
  allowNegativeStock                                     Boolean  @default(false)
  showBarcodeFieldInStockTransactions                    Boolean  @default(false)
  convertItemDescriptionToCleanHtmlInTransactions        Boolean  @default(false)
  overTransferAllowancePercent                           Float    @default(0)
  allowInternalTransfersAtArmsLengthPrice                Boolean  @default(false)
  overPickingAllowancePercent                            Float    @default(0)
  actionIfQualityInspectionIsNotSubmitted                String   @db.VarChar(20) @default("STOP")
  actionIfQualityInspectionIsRejected                    String   @db.VarChar(20) @default("STOP")
  enableStockReservation                                 Boolean  @default(false)
  allowPartialReservation                                Boolean  @default(false)
  autoReserveStockForSalesOrderOnPurchase                Boolean  @default(false)
  autoReserveSerialAndBatchNos                           Boolean  @default(false)
  autoCreateSerialAndBatchBundleForOutward               Boolean  @default(false)
  disableSerialNoAndBatchSelector                        Boolean  @default(false)
  haveDefaultNamingSeriesForBatchId                      Boolean  @default(false)
  pickSerialBatchBasedOn                                 String   @db.VarChar(20) @default("FIFO")
  useSerialBatchFields                                   Boolean  @default(false)
  doNotUpdateSerialBatchOnCreationOfAutoBundle           Boolean  @default(false)
  allowExistingSerialNoToBeManufacturedReceivedAgain     Boolean  @default(false)
  setSerialAndBatchBundleNamingBasedOnNamingSeries       Boolean  @default(false)
  raiseMaterialRequestWhenStockReachesReorderLevel       Boolean  @default(false)
  notifyByEmailOnCreationOfAutomaticMaterialRequest      Boolean  @default(false)
  allowMaterialTransferFromDeliveryNoteToSalesInvoice    Boolean  @default(false)
  allowMaterialTransferFromPurchaseReceiptToPurchaseInvoice Boolean @default(false)
  freezeStocksOlderThanDays                              Int      @default(60)
  createdAt                                              DateTime @default(now())
  updatedAt                                              DateTime @updatedAt

  @@map("stock_settings")
}

model ItemVariantSettings {
  id                        String                     @id @default(cuid())
  singletonKey              String                     @unique @default("default") @db.VarChar(32)
  doNotUpdateVariantsOnSave Boolean                    @default(false)
  allowRenameAttributeValue Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  copyFields                ItemVariantSettingsField[]

  @@map("item_variant_settings")
}

model ItemVariantSettingsField {
  id         String              @id @default(cuid())
  settingsId String
  fieldKey   String              @db.VarChar(100)
  position   Int
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  settings   ItemVariantSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, fieldKey])
  @@unique([settingsId, position])
  @@index([settingsId])
  @@map("item_variant_settings_fields")
}

model Item {
  id                     String              @id @default(cuid())
  name                   String              @db.VarChar(255)
  code                   String              @unique @db.VarChar(100)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  itemGroupId            String?
  disabled               Boolean             @default(false)
  allowAlternateItem     Boolean             @default(false)
  maintainStock          Boolean             @default(false)
  openingStock           Int                 @default(0)
  valuationRate          Float               @default(0.0)
  standardSellingRate    Float               @default(0.0)
  defaultUnitOfMeasureId String?
  description            String?
  brandId                String?
  brand                  Brand?              @relation(fields: [brandId], references: [id])
  defaultUnitOfMeasure   UnitOfMeasurement?  @relation(fields: [defaultUnitOfMeasureId], references: [id])
  itemGroup              ItemGroup?          @relation(fields: [itemGroupId], references: [id])
  alternateItems         ItemAlternate[]     @relation("AlternateItem")
  primaryItemAlternates  ItemAlternate[]     @relation("PrimaryItem")
  productBundles         ProductBundle[]
  productBundleItems     ProductBundleItem[]
  itemManufacturers      ItemManufacturer[]
}

model UnitOfMeasurement {
  id                 String              @id @default(cuid())
  name               String              @db.VarChar(255)
  disabled           Boolean             @default(false)
  isWholeNumber      Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              Item[]
  inventoryItems     InventoryItem[]
  productBundleItems ProductBundleItem[]
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]
}

model ItemAttribute {
  id              String               @id @default(cuid())
  name            String               @db.VarChar(255)
  disabled        Boolean              @default(false)
  numericValues   Boolean              @default(false)
  fromRange       Float                @default(0)
  toRange         Float                @default(0)
  increment       Float                @default(0)
  attributeValues ItemAttributeValue[]
  inventoryItemAttributes InventoryItemAttribute[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([name])
  @@index([disabled])
  @@map("item_attributes")
}

model ItemAttributeValue {
  id             String        @id @default(cuid())
  attributeId    String
  attributeValue String        @db.VarChar(255)
  abbreviation   String        @db.VarChar(50)
  position       Int           @default(0)
  attribute      ItemAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([attributeId, attributeValue])
  @@index([attributeId])
  @@map("item_attribute_values")
}

model Warehouse {
  id                          String      @id @default(cuid())
  name                        String      @unique @db.VarChar(255)
  disabled                    Boolean     @default(false)
  isGroupWarehouse            Boolean     @default(false)
  parentWarehouseId           String?
  company                     String      @db.VarChar(255)
  isRejectedWarehouse         Boolean     @default(false)
  phoneNo                     String?     @db.VarChar(50)
  mobileNo                    String?     @db.VarChar(50)
  addressLine1                String?     @db.VarChar(255)
  addressLine2                String?     @db.VarChar(255)
  city                        String?     @db.VarChar(255)
  state                       String?     @db.VarChar(255)
  pin                         String?     @db.VarChar(20)
  warehouseType               String?     @db.VarChar(100)
  defaultInTransitWarehouseId String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  parentWarehouse             Warehouse?  @relation("WarehouseHierarchy", fields: [parentWarehouseId], references: [id])
  childWarehouses             Warehouse[] @relation("WarehouseHierarchy")
  defaultInTransitWarehouse   Warehouse?  @relation("WarehouseTransitDefault", fields: [defaultInTransitWarehouseId], references: [id])
  transitDefaultFor           Warehouse[] @relation("WarehouseTransitDefault")
  currentBatches              Batch[]     @relation("BatchCurrentWarehouse")
  currentSerialNos            SerialNo[]  @relation("SerialNoCurrentWarehouse")
  serialNoStatusHistory       SerialNoHistory[]

  @@index([company])
  @@index([disabled])
  @@index([isGroupWarehouse])
  @@index([parentWarehouseId])
  @@index([defaultInTransitWarehouseId])
  @@map("warehouses")
}

model ProductBundle {
  id           String              @id @default(cuid())
  parentItemId String
  description  String?
  disabled     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  parentItem   Item                @relation(fields: [parentItemId], references: [id])
  bundleItems  ProductBundleItem[]
}

model ProductBundleItem {
  id                  String             @id @default(cuid())
  bundleId            String
  itemId              String
  quantity            Int                @default(1)
  description         String?
  UnitOfMeasurementId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  unitOfMeasurement   UnitOfMeasurement? @relation(fields: [UnitOfMeasurementId], references: [id])
  bundle              ProductBundle      @relation(fields: [bundleId], references: [id])
  item                Item               @relation(fields: [itemId], references: [id])

  @@unique([bundleId, itemId])
}

model ShippingRule {
  id                String          @id @default(cuid())
  shippingRuleLabel String          @db.VarChar(255)
  shippingRuleType  RuleType
  disabled          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  calculateBasedOn  CalculationType
  shippingAmount    Float           @default(0.0)
}

model ItemAlternate {
  id              String   @id @default(cuid())
  itemId          String
  alternateItemId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  alternateItem   Item     @relation("AlternateItem", fields: [alternateItemId], references: [id])
  item            Item     @relation("PrimaryItem", fields: [itemId], references: [id])

  @@unique([itemId, alternateItemId])
}

model ItemManufacturer {
  id                     String   @id @default(cuid())
  itemId                 String
  manufacturer           String   @db.VarChar(255)
  manufacturerPartNumber String   @db.VarChar(255)
  isDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  item                   Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, manufacturer, manufacturerPartNumber])
  @@index([itemId])
  @@map("item_manufacturers")
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  emailVerified   Boolean         @default(false)
  username        String?         @unique
  image           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  displayUsername String?
  department      String?         @db.VarChar(100)
  displayName     String?         @db.VarChar(150)
  isActive        Boolean         @default(true)
  managerId       String?
  mustChangePassword Boolean      @default(false)
  passwordChangedAt  DateTime?
  accounts        Account[]
  supervisedApps  AppSupervisor[] @relation("AppSupervisor")
  sessions        Session[]
  teamMemberships TeamMember[]    @relation("TeamMembership")
  managedTeams    Team[]          @relation("TeamManager")
  userRoles       UserRole[]
  manager         User?           @relation("ManagerSubordinate", fields: [managerId], references: [id])
  subordinates    User[]          @relation("ManagerSubordinate")

  @@index([isActive])
  @@index([managerId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

/// Role definition with system-level and app-level support
model Role {
  id              String           @id @default(cuid())
  key             String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String?
  level           Int              @default(0)
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([key])
  @@index([level])
  @@map("roles")
}

/// Permission definition for fine-grained access control
model Permission {
  id              String           @id @default(cuid())
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(150)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([key])
  @@map("permissions")
}

/// Many-to-many relationship between roles and permissions
model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// User-role assignment with optional app scoping
model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  appKey     String?  @db.VarChar(50)
  assignedBy String?
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, appKey])
  @@index([userId])
  @@index([roleId])
  @@index([appKey])
  @@map("user_roles")
}

/// Application definition for multi-app authorization
model App {
  appKey         String          @id @db.VarChar(50)
  name           String          @db.VarChar(100)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appSupervisors AppSupervisor[]
  teams          Team[]

  @@map("apps")
}

/// App-level supervisors (managers with special privileges for specific apps)
model AppSupervisor {
  id               String   @id @default(cuid())
  appKey           String
  supervisorUserId String
  createdBy        String?
  createdAt        DateTime @default(now())
  app              App      @relation(fields: [appKey], references: [appKey], onDelete: Cascade)
  supervisorUser   User     @relation("AppSupervisor", fields: [supervisorUserId], references: [id], onDelete: Cascade)

  @@unique([appKey, supervisorUserId])
  @@index([appKey])
  @@index([supervisorUserId])
  @@map("app_supervisors")
}

/// Team definition for hierarchical access control
model Team {
  id            String       @id @default(cuid())
  appKey        String
  name          String       @db.VarChar(100)
  managerUserId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teamMembers   TeamMember[]
  app           App          @relation(fields: [appKey], references: [appKey], onDelete: Cascade)
  managerUser   User?        @relation("TeamManager", fields: [managerUserId], references: [id])

  @@index([appKey])
  @@index([managerUserId])
  @@map("teams")
}

/// Team membership for users
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("TeamMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

/// Audit log for authorization changes
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   @db.VarChar(100)
  subjectType String   @db.VarChar(50)
  subjectId   String?  @db.VarChar(100)
  appKey      String?  @db.VarChar(50)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([subjectType])
  @@index([createdAt])
  @@map("audit_logs")
}

model MaterialRequest {
  id              String                  @id @default(cuid())
  series          String                  @unique @db.VarChar(50)
  transactionDate DateTime                @default(now())
  purpose         MaterialRequestPurpose  @default(PURCHASE)
  company         String                  @db.VarChar(255)
  requiredBy      DateTime?
  status          MaterialRequestStatus   @default(PENDING)
  targetWarehouse String?                 @db.VarChar(255)
  terms           String?                 @db.VarChar(255)
  termsContent    String?
  letterHead      String?                 @db.VarChar(255)
  printHeading    String?                 @db.VarChar(255)
  items           MaterialRequestItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([series])
  @@index([status])
  @@index([transactionDate])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                String          @id @default(cuid())
  materialRequestId String
  itemCode          String          @db.VarChar(100)
  itemName          String?         @db.VarChar(255)
  requiredBy        DateTime?
  quantity          Float           @default(0)
  orderedQty        Float           @default(0)
  receivedQty       Float           @default(0)
  targetWarehouse   String?         @db.VarChar(255)
  unitOfMeasure     String?         @db.VarChar(50)
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)

  @@index([materialRequestId])
  @@map("material_request_items")
}

enum MaterialRequestPurpose {
  PURCHASE
  MANUFACTURE
  MATERIAL_TRANSFER
  MATERIAL_ISSUE
  CUSTOMER_PROVIDED
}

enum MaterialRequestStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  PARTIALLY_ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model StockEntry {
  id                     String           @id @default(cuid())
  series                 String           @unique @db.VarChar(50)
  stockEntryType         StockEntryType
  postingDate            DateTime         @default(now())
  company                String           @db.VarChar(255)
  status                 StockEntryStatus @default(DRAFT)
  project                String?          @db.VarChar(255)
  defaultSourceWarehouse String?          @db.VarChar(255)
  defaultTargetWarehouse String?          @db.VarChar(255)
  isOpening              Boolean          @default(false)
  remarks                String?
  printHeading           String?          @db.VarChar(255)
  letterHead             String?          @db.VarChar(255)
  inspectionRequired     Boolean          @default(false)
  items                  StockEntryItem[]
  batches                Batch[]
  serialNos              SerialNo[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([series])
  @@index([status])
  @@index([postingDate])
  @@map("stock_entries")
}

model StockEntryItem {
  id              String     @id @default(cuid())
  stockEntryId    String
  sourceWarehouse String?    @db.VarChar(255)
  targetWarehouse String?    @db.VarChar(255)
  itemCode        String     @db.VarChar(100)
  itemName        String?    @db.VarChar(255)
  description     String?
  qty             Float      @default(0)
  basicRate       Float      @default(0)
  basicAmount     Float      @default(0)
  unitOfMeasure   String?    @db.VarChar(50)
  stockEntry      StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)

