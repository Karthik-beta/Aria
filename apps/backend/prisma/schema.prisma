// ============================================================================
// Prisma v7 Schema Configuration
// ============================================================================
//
// This schema uses Prisma ORM v7, which introduces a Rust-free architecture
// with significant changes from v6. Key differences:
//
// GENERATOR BLOCK:
// - `provider = "prisma-client"` replaces the old "prisma-client-js"
// - `output` is now REQUIRED (no longer generates to node_modules)
// - `moduleFormat` can be "esm" or "cjs" (use "cjs" for NestJS compatibility)
//
// DATASOURCE BLOCK:
// - `url` field is DEPRECATED - configure in prisma.config.ts instead
// - Only `provider` is required here
//
// @see https://www.prisma.io/docs/orm/more/upgrade-guides/upgrading-versions/upgrading-to-prisma-7
// ============================================================================

generator client {
  // Prisma v7 uses "prisma-client" instead of "prisma-client-js"
  // This enables the new Rust-free TypeScript-native query engine
  provider     = "prisma-client"
  
  // REQUIRED in v7: Custom output path for generated client
  // Import from: '../generated/prisma/client.js' (relative to src/)
  output       = "../src/generated/prisma"
  
  // Module format: "cjs" for CommonJS (NestJS), "esm" for ES Modules
  moduleFormat = "cjs"
}

datasource db {
  // Database provider - the connection URL is configured in prisma.config.ts
  // (The `url` field is deprecated in Prisma v7)
  provider = "postgresql"
}


model InventoryItem {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(100)

  itemGroup   ItemGroup? @relation(fields: [itemGroupId], references: [id])
  itemGroupId String?

  description        String?
  disabled           Boolean @default(false)
  maintainStock      Boolean @default(true)
  allowAlternateItem Boolean @default(false)
  hasVariants        Boolean @default(false)

  // Stock and pricing
  openingStock        Int    @default(0)
  valuationRate       Float?
  standardSellingRate Float?

  // Tax settings
  isZeroRated  Boolean @default(false)
  isExempt     Boolean @default(false)
  isFixedAsset Boolean @default(false)
  taxCode      String? @db.VarChar(50)

  // Inventory Settings
  shelfLifeInDays            Int?
  warrantyPeriodInDays       Int?
  endOfLife                  DateTime?
  weightPerUnit              Float?
  weightUom                  String?   @db.VarChar(50)
  allowNegativeStock         Boolean   @default(false)
  valuationMethod            String?   @db.VarChar(50)
  defaultMaterialRequestType String?   @db.VarChar(50)

  // Serial Nos and Batches
  hasBatchNo  Boolean @default(false)
  hasSerialNo Boolean @default(false)

  barcodes        ItemBarcode[]
  reorderSettings ItemReorder[]

  defaultUnitOfMeasureId String?
  defaultUnitOfMeasure   UnitOfMeasurement? @relation(fields: [defaultUnitOfMeasureId], references: [id])

  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([name])
  @@index([createdAt])
  @@map("inventory_items")
}

model ItemBarcode {
  id          String        @id @default(cuid())
  itemId      String
  barcode     String        @db.VarChar(255)
  barcodeType String?       @db.VarChar(100)
  uom         String?       @db.VarChar(50)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_barcodes")
}

model ItemReorder {
  id                  String        @id @default(cuid())
  itemId              String
  warehouse           String        @db.VarChar(255)
  reorderLevel        Float         @default(0)
  reorderQty          Float         @default(0)
  materialRequestType String?       @db.VarChar(100)
  item                InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_reorder_settings")
}



model ItemGroup {
  id              String             @id @default(cuid())
  groupName       String             @db.VarChar(255)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  parentId        String?
  isGroup         Boolean            @default(false)
  items           Item[]
  inventoryItems  InventoryItem[]
  defaults        ItemGroupDefault[]
  parentItemGroup ItemGroup?         @relation("ItemGroupHierarchy", fields: [parentId], references: [id])
  children        ItemGroup[]        @relation("ItemGroupHierarchy")
}

model ItemGroupDefault {
  id               String    @id @default(cuid())
  itemGroupId      String
  company          String    @db.VarChar(255)
  defaultWarehouse String?   @db.VarChar(255)
  defaultPriceList String?   @db.VarChar(255)
  itemGroup        ItemGroup @relation(fields: [itemGroupId], references: [id], onDelete: Cascade)

  @@map("item_group_defaults")
}

model Item {
  id                     String              @id @default(cuid())
  name                   String              @db.VarChar(255)
  code                   String              @unique @db.VarChar(100)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  itemGroupId            String?
  disabled               Boolean             @default(false)
  allowAlternateItem     Boolean             @default(false)
  maintainStock          Boolean             @default(false)
  openingStock           Int                 @default(0)
  valuationRate          Float               @default(0.0)
  standardSellingRate    Float               @default(0.0)
  defaultUnitOfMeasureId String?
  description            String?
  brandId                String?
  brand                  Brand?              @relation(fields: [brandId], references: [id])
  defaultUnitOfMeasure   UnitOfMeasurement?  @relation(fields: [defaultUnitOfMeasureId], references: [id])
  itemGroup              ItemGroup?          @relation(fields: [itemGroupId], references: [id])
  alternateItems         ItemAlternate[]     @relation("AlternateItem")
  primaryItemAlternates  ItemAlternate[]     @relation("PrimaryItem")
  productBundles         ProductBundle[]
  productBundleItems     ProductBundleItem[]
  itemManufacturers      ItemManufacturer[]
}

model UnitOfMeasurement {
  id                 String              @id @default(cuid())
  name               String              @db.VarChar(255)
  disabled           Boolean             @default(false)
  isWholeNumber      Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              Item[]
  inventoryItems     InventoryItem[]
  productBundleItems ProductBundleItem[]
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]
}

model ProductBundle {
  id           String              @id @default(cuid())
  parentItemId String
  description  String?
  disabled     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  parentItem   Item                @relation(fields: [parentItemId], references: [id])
  bundleItems  ProductBundleItem[]
}

model ProductBundleItem {
  id                  String             @id @default(cuid())
  bundleId            String
  itemId              String
  quantity            Int                @default(1)
  description         String?
  UnitOfMeasurementId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  unitOfMeasurement   UnitOfMeasurement? @relation(fields: [UnitOfMeasurementId], references: [id])
  bundle              ProductBundle      @relation(fields: [bundleId], references: [id])
  item                Item               @relation(fields: [itemId], references: [id])

  @@unique([bundleId, itemId])
}

model ShippingRule {
  id                String          @id @default(cuid())
  shippingRuleLabel String          @db.VarChar(255)
  shippingRuleType  RuleType
  disabled          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  calculateBasedOn  CalculationType
  shippingAmount    Float           @default(0.0)
}

model ItemAlternate {
  id              String   @id @default(cuid())
  itemId          String
  alternateItemId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  alternateItem   Item     @relation("AlternateItem", fields: [alternateItemId], references: [id])
  item            Item     @relation("PrimaryItem", fields: [itemId], references: [id])

  @@unique([itemId, alternateItemId])
}

model ItemManufacturer {
  id                     String   @id @default(cuid())
  itemId                 String
  manufacturer           String   @db.VarChar(255)
  manufacturerPartNumber String   @db.VarChar(255)
  isDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  item                   Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, manufacturer, manufacturerPartNumber])
  @@index([itemId])
  @@map("item_manufacturers")
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  emailVerified   Boolean         @default(false)
  username        String?         @unique
  image           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  displayUsername String?
  department      String?         @db.VarChar(100)
  displayName     String?         @db.VarChar(150)
  isActive        Boolean         @default(true)
  managerId       String?
  mustChangePassword Boolean      @default(false)
  passwordChangedAt  DateTime?
  accounts        Account[]
  supervisedApps  AppSupervisor[] @relation("AppSupervisor")
  sessions        Session[]
  teamMemberships TeamMember[]    @relation("TeamMembership")
  managedTeams    Team[]          @relation("TeamManager")
  userRoles       UserRole[]
  manager         User?           @relation("ManagerSubordinate", fields: [managerId], references: [id])
  subordinates    User[]          @relation("ManagerSubordinate")

  @@index([isActive])
  @@index([managerId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

/// Role definition with system-level and app-level support
model Role {
  id              String           @id @default(cuid())
  key             String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String?
  level           Int              @default(0)
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([key])
  @@index([level])
  @@map("roles")
}

/// Permission definition for fine-grained access control
model Permission {
  id              String           @id @default(cuid())
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(150)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([key])
  @@map("permissions")
}

/// Many-to-many relationship between roles and permissions
model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// User-role assignment with optional app scoping
model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  appKey     String?  @db.VarChar(50)
  assignedBy String?
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, appKey])
  @@index([userId])
  @@index([roleId])
  @@index([appKey])
  @@map("user_roles")
}

/// Application definition for multi-app authorization
model App {
  appKey         String          @id @db.VarChar(50)
  name           String          @db.VarChar(100)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appSupervisors AppSupervisor[]
  teams          Team[]

  @@map("apps")
}

/// App-level supervisors (managers with special privileges for specific apps)
model AppSupervisor {
  id               String   @id @default(cuid())
  appKey           String
  supervisorUserId String
  createdBy        String?
  createdAt        DateTime @default(now())
  app              App      @relation(fields: [appKey], references: [appKey], onDelete: Cascade)
  supervisorUser   User     @relation("AppSupervisor", fields: [supervisorUserId], references: [id], onDelete: Cascade)

  @@unique([appKey, supervisorUserId])
  @@index([appKey])
  @@index([supervisorUserId])
  @@map("app_supervisors")
}

/// Team definition for hierarchical access control
model Team {
  id            String       @id @default(cuid())
  appKey        String
  name          String       @db.VarChar(100)
  managerUserId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teamMembers   TeamMember[]
  app           App          @relation(fields: [appKey], references: [appKey], onDelete: Cascade)
  managerUser   User?        @relation("TeamManager", fields: [managerUserId], references: [id])

  @@index([appKey])
  @@index([managerUserId])
  @@map("teams")
}

/// Team membership for users
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("TeamMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

/// Audit log for authorization changes
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   @db.VarChar(100)
  subjectType String   @db.VarChar(50)
  subjectId   String?  @db.VarChar(100)
  appKey      String?  @db.VarChar(50)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([subjectType])
  @@index([createdAt])
  @@map("audit_logs")
}

model MaterialRequest {
  id              String                  @id @default(cuid())
  series          String                  @unique @db.VarChar(50)
  transactionDate DateTime                @default(now())
  purpose         MaterialRequestPurpose  @default(PURCHASE)
  company         String                  @db.VarChar(255)
  requiredBy      DateTime?
  status          MaterialRequestStatus   @default(PENDING)
  targetWarehouse String?                 @db.VarChar(255)
  terms           String?                 @db.VarChar(255)
  termsContent    String?
  letterHead      String?                 @db.VarChar(255)
  printHeading    String?                 @db.VarChar(255)
  items           MaterialRequestItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([series])
  @@index([status])
  @@index([transactionDate])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                String          @id @default(cuid())
  materialRequestId String
  itemCode          String          @db.VarChar(100)
  itemName          String?         @db.VarChar(255)
  requiredBy        DateTime?
  quantity          Float           @default(0)
  orderedQty        Float           @default(0)
  receivedQty       Float           @default(0)
  targetWarehouse   String?         @db.VarChar(255)
  unitOfMeasure     String?         @db.VarChar(50)
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)

  @@index([materialRequestId])
  @@map("material_request_items")
}

enum MaterialRequestPurpose {
  PURCHASE
  MANUFACTURE
  MATERIAL_TRANSFER
  MATERIAL_ISSUE
  CUSTOMER_PROVIDED
}

enum MaterialRequestStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  PARTIALLY_ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model StockEntry {
  id                     String           @id @default(cuid())
  series                 String           @unique @db.VarChar(50)
  stockEntryType         StockEntryType
  postingDate            DateTime         @default(now())
  company                String           @db.VarChar(255)
  status                 StockEntryStatus @default(DRAFT)
  project                String?          @db.VarChar(255)
  defaultSourceWarehouse String?          @db.VarChar(255)
  defaultTargetWarehouse String?          @db.VarChar(255)
  isOpening              Boolean          @default(false)
  remarks                String?
  printHeading           String?          @db.VarChar(255)
  letterHead             String?          @db.VarChar(255)
  inspectionRequired     Boolean          @default(false)
  items                  StockEntryItem[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([series])
  @@index([status])
  @@index([postingDate])
  @@map("stock_entries")
}

model StockEntryItem {
  id              String     @id @default(cuid())
  stockEntryId    String
  sourceWarehouse String?    @db.VarChar(255)
  targetWarehouse String?    @db.VarChar(255)
  itemCode        String     @db.VarChar(100)
  itemName        String?    @db.VarChar(255)
  description     String?
  qty             Float      @default(0)
  basicRate       Float      @default(0)
  basicAmount     Float      @default(0)
  unitOfMeasure   String?    @db.VarChar(50)
  stockEntry      StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)

  @@index([stockEntryId])
  @@map("stock_entry_items")
}

enum StockEntryType {
  MATERIAL_RECEIPT
  MATERIAL_ISSUE
  MATERIAL_TRANSFER
  MATERIAL_TRANSFER_FOR_MANUFACTURE
  MANUFACTURE
  REPACK
  SEND_TO_SUBCONTRACTOR
}

enum StockEntryStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum RuleType {
  SELLING
  BUYING
}

enum CalculationType {
  FIXED
  NET_TOTAL
  NET_WEIGHT
}

model DeliveryNote {
  id                       String             @id @default(cuid())
  series                   String             @unique @db.VarChar(50)
  postingDate              DateTime           @default(now())
  customer                 String             @db.VarChar(255)
  company                  String             @db.VarChar(255)
  status                   DeliveryNoteStatus @default(DRAFT)
  isReturn                 Boolean            @default(false)

  // Currency and Price List
  currency                 String?            @db.VarChar(10)
  priceList                String?            @db.VarChar(255)

  // Source Warehouse (applied to all items by default)
  sourceWarehouse          String?            @db.VarChar(255)

  // Totals
  totalQuantity            Float              @default(0)
  totalAmount              Float              @default(0)
  grandTotal               Float              @default(0)
  roundingAdjustment       Float              @default(0)
  roundedTotal             Float              @default(0)

  // Additional Discount
  additionalDiscountOn     String?            @db.VarChar(100)
  additionalDiscountPercent Float?
  additionalDiscountAmount Float?

  // Address & Contact
  shippingAddress          String?            @db.VarChar(255)
  dispatchAddress          String?            @db.VarChar(255)
  companyAddress           String?            @db.VarChar(255)
  companyContact           String?            @db.VarChar(255)
  companyTRN               String?            @db.VarChar(100)

  // Terms
  terms                    String?            @db.VarChar(255)
  // Stored as PostgreSQL TEXT to align with Zod 65,535-character limit
  termsContent             String?            @db.Text

  // Transporter Info
  transporter              String?            @db.VarChar(255)
  driverName               String?            @db.VarChar(255)
  driver                   String?            @db.VarChar(255)
  transportReceiptDate     DateTime?
  transportReceiptNo       String?            @db.VarChar(255)
  vehicleNo                String?            @db.VarChar(100)

  // Customer PO Details
  customerPoNo             String?
  customerPoDate           DateTime?

  // Commission
  salesPartner             String?            @db.VarChar(255)
  commissionRate           Float?

  // Print Settings
  letterHead               String?            @db.VarChar(255)
  printHeading             String?            @db.VarChar(255)
  printWithoutAmount       Boolean            @default(false)
  groupSameItems           Boolean            @default(false)

  // VAT Details
  permitNumber             String?            @db.VarChar(255)
  vatEmirate               String?            @db.VarChar(100)

  // Additional Info
  project                  String?            @db.VarChar(255)

  items     DeliveryNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([series])
  @@index([status])
  @@index([postingDate])
  @@index([customer])
  @@map("delivery_notes")
}

model DeliveryNoteItem {
  id             String       @id @default(cuid())
  deliveryNoteId String
  itemCode       String       @db.VarChar(100)
  itemName       String?      @db.VarChar(255)
  description    String?
  quantity       Float        @default(0)
  uom            String?      @db.VarChar(50)
  rate           Float        @default(0)
  amount         Float        @default(0)
  warehouse      String?      @db.VarChar(255)
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_note_items")
}

enum DeliveryNoteStatus {
  DRAFT
  TO_BILL
  COMPLETED
  RETURN_ISSUED
  CANCELLED
  CLOSED
}

model PurchaseReceipt {
  id                             String                @id @default(cuid())
  series                         String                @unique @db.VarChar(50)
  seriesPattern                  String                @default("MAT-PRE-.YYYY.-") @db.VarChar(50)
  postingDate                    DateTime              @default(now())
  postingTime                    String                @default("00:00:00") @db.VarChar(8)
  editPostingDateTime            Boolean               @default(false)
  supplier                       String                @db.VarChar(255)
  company                        String                @db.VarChar(255)
  status                         PurchaseReceiptStatus @default(DRAFT)
  isReturn                       Boolean               @default(false)
  applyPutawayRule               Boolean               @default(false)
  supplierDeliveryNote           String?               @db.VarChar(255)
  acceptedWarehouse              String?               @db.VarChar(255)
  rejectedWarehouse              String?               @db.VarChar(255)
  isSubcontracted                Boolean               @default(false)
  currency                       String?               @db.VarChar(10)
  priceList                      String?               @db.VarChar(255)
  totalQuantity                  Float                 @default(0)
  totalAcceptedQuantity          Float                 @default(0)
  totalRejectedQuantity          Float                 @default(0)
  totalAmount                    Float                 @default(0)
  taxesAndChargesAdded           Float                 @default(0)
  taxesAndChargesDeducted        Float                 @default(0)
  totalTaxesAndCharges           Float                 @default(0)
  grandTotal                     Float                 @default(0)
  roundingAdjustment             Float                 @default(0)
  roundedTotal                   Float                 @default(0)
  disableRoundedTotal            Boolean               @default(false)
  supplierAddress                String?               @db.VarChar(255)
  contactPerson                  String?               @db.VarChar(255)
  shippingAddressTemplate        String?               @db.VarChar(255)
  companyTRN                     String?               @db.VarChar(100)
  billingAddress                 String?               @db.VarChar(255)
  terms                          String?               @db.VarChar(255)
  termsContent                   String?               @db.Text
  letterHead                     String?               @db.VarChar(255)
  printHeading                   String?               @db.VarChar(255)
  groupSameItems                 Boolean               @default(false)
  permitNumber                   String?               @db.VarChar(255)
  recoverableStandardRatedExpenses Float               @default(0)
  reverseChargeApplicable        String                @default("N") @db.VarChar(10)
  transporterName                String?               @db.VarChar(255)
  vehicleNumber                  String?               @db.VarChar(100)
  vehicleDate                    DateTime?
  instructions                   String?
  remarks                        String?
  isInternalSupplier             Boolean               @default(false)
  items                          PurchaseReceiptItem[]
  taxes                          PurchaseReceiptTax[]
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  @@index([series])
  @@index([status])
  @@index([postingDate])
  @@index([supplier])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id               String          @id @default(cuid())
  purchaseReceiptId String
  itemCode         String          @db.VarChar(100)
  itemName         String?         @db.VarChar(255)
  description      String?
  acceptedQuantity Float           @default(0)
  rejectedQuantity Float           @default(0)
  rate             Float           @default(0)
  amount           Float           @default(0)
  uom              String?         @db.VarChar(50)
  acceptedWarehouse String?        @db.VarChar(255)
  rejectedWarehouse String?        @db.VarChar(255)
  purchaseReceipt  PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)

  @@index([purchaseReceiptId])
  @@map("purchase_receipt_items")
}

model PurchaseReceiptTax {
  id               String          @id @default(cuid())
  purchaseReceiptId String
  type             String          @db.VarChar(255)
  accountHead      String          @db.VarChar(255)
  taxRate          Float           @default(0)
  amount           Float           @default(0)
  total            Float           @default(0)
  purchaseReceipt  PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)

  @@index([purchaseReceiptId])
  @@map("purchase_receipt_taxes")
}

enum PurchaseReceiptStatus {
  DRAFT
  PARTLY_BILLED
  TO_BILL
  COMPLETED
  RETURN_ISSUED
  CANCELLED
  CLOSED
}

enum PickListStatus {
  DRAFT
  OPEN
  COMPLETED
  CANCELLED
}

enum PickListPurpose {
  MATERIAL_TRANSFER_FOR_MANUFACTURE
  DELIVERY
  MATERIAL_TRANSFER
}

model PickList {
  id                          String          @id @default(cuid())
  series                      String          @unique @db.VarChar(50)
  seriesPattern               String          @default("STO-PICK-.YYYY.-") @db.VarChar(50)
  status                      PickListStatus  @default(DRAFT)
  company                     String          @db.VarChar(255)
  customer                    String?         @db.VarChar(255)
  purpose                     PickListPurpose @default(MATERIAL_TRANSFER_FOR_MANUFACTURE)
  workOrder                   String?         @db.VarChar(255)
  warehouse                   String?         @db.VarChar(255)
  considerRejectedWarehouses  Boolean         @default(false)
  pickManually                Boolean         @default(false)
  ignorePricingRule           Boolean         @default(false)
  scanMode                    Boolean         @default(false)
  promptQty                   Boolean         @default(false)
  scanBarcode                 String?         @db.VarChar(255)
  groupSameItems              Boolean         @default(false)
  items                       PickListItem[]
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([series])
  @@index([status])
  @@map("pick_lists")
}

model PickListItem {
  id         String   @id @default(cuid())
  pickListId String
  item       String   @db.VarChar(255)
  warehouse  String?  @db.VarChar(255)
  qty        Float    @default(0)
  stockQty   Float?
  pickedQty  Float?
  pickList   PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)

  @@index([pickListId])
  @@map("pick_list_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Delivery Trip
// ─────────────────────────────────────────────────────────────────────────────

enum DeliveryTripStatus {
  DRAFT
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model DeliveryTrip {
  id                             String              @id @default(cuid())
  series                         String              @unique @db.VarChar(50)
  seriesPattern                  String              @default("MAT-DT-.YYYY.-") @db.VarChar(50)
  status                         DeliveryTripStatus  @default(DRAFT)
  company                        String              @db.VarChar(255)
  driver                         String?             @db.VarChar(255)
  driverAddress                  String?             @db.VarChar(500)
  vehicle                        String?             @db.VarChar(255)
  departureTime                  DateTime?
  initialEmailNotificationSent   Boolean             @default(false)
  stops                          DeliveryTripStop[]
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt

  @@index([series])
  @@index([status])
  @@map("delivery_trips")
}

model DeliveryTripStop {
  id               String       @id @default(cuid())
  deliveryTripId   String
  stopNumber       Int
  customer         String?      @db.VarChar(255)
  addressName      String       @db.VarChar(500)
  locked           Boolean      @default(false)
  deliveryNote     String?      @db.VarChar(50)
  estimatedArrival DateTime?
  deliveryTrip     DeliveryTrip @relation(fields: [deliveryTripId], references: [id], onDelete: Cascade)

  @@index([deliveryTripId])
  @@map("delivery_trip_stops")
}
