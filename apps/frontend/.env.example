# Frontend Environment Variables
# Copy this file to .env.local for local development

# ============================================================================
# tRPC API Configuration
# ============================================================================

# Backend API URL (without trailing slash)
# The frontend will append /trpc for HTTP requests and /trpc-ws for WebSocket connections
# 
# Local development (pnpm dev): http://localhost:3001
# Docker development: http://caddy (resolved via Docker network)
# Production: https://your-domain.com
#
# Official tRPC docs: https://trpc.io/docs/client/links/wsLink
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# Next.js Configuration
# ============================================================================

# Disable Next.js telemetry (optional)
NEXT_TELEMETRY_DISABLED=1

# Sentry auth token for build-time release/source map upload.
# Set this in CI or local build env to avoid Sentry build warnings.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================================
# Authentication Configuration (Production Only)
# ============================================================================
# Authentication is ONLY enabled when NODE_ENV=production
# In development, authentication is bypassed for faster iteration

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-very-secret-and-strong-session-key-here

# Zitadel Configuration
# Official docs: https://zitadel.com/docs/sdk-examples/nextjs
ZITADEL_DOMAIN=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=your-client-id
ZITADEL_CLIENT_SECRET=your-client-secret
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback/zitadel
ZITADEL_POST_LOGOUT_URL=http://localhost:3000

# Default User Configuration (Production Only)
# These credentials are used to create a default admin user on first deployment
DEFAULT_USER_EMAIL=admin@aria-erp.local
DEFAULT_USER_PASSWORD=change-this-secure-password
DEFAULT_USER_FIRSTNAME=Admin
DEFAULT_USER_LASTNAME=User
