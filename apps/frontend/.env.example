# Frontend Environment Variables
# Copy this file to .env.local for local development

# ============================================================================
# tRPC API Configuration
# ============================================================================

# Backend API URL (without trailing slash)
# The frontend will append /trpc for HTTP requests and /trpc-ws for WebSocket connections
# 
# Local development (pnpm dev): http://localhost:3001
# Docker development: http://caddy (resolved via Docker network)
# Production: https://your-domain.com
#
# Official tRPC docs: https://trpc.io/docs/client/links/wsLink
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# Next.js Configuration
# ============================================================================

# Disable Next.js telemetry (optional)
NEXT_TELEMETRY_DISABLED=1

# Sentry auth token for build-time release/source map upload.
# Set this in CI or local build env to avoid Sentry build warnings.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================================
# Authentication Configuration
# ============================================================================
# Development bypass for local preview builds (set to true to skip sign-in redirects)
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Default User Configuration (Production Only)
# These credentials are used to create a default admin user on first deployment
DEFAULT_USER_EMAIL=admin@aria-erp.local
DEFAULT_USER_PASSWORD=change-this-secure-password
DEFAULT_USER_FIRSTNAME=Admin
DEFAULT_USER_LASTNAME=User
