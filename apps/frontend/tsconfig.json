{
  "extends": "@aria/tsconfig/next.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "backend": [
        "../backend/src"
      ],
      "backend/*": [
        "../backend/src/*"
      ],
      "@aria/types": [
        "../../packages/types/src/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}