{
  "extends": "@aria/tsconfig/next.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "backend": ["../backend/dist/src"],
      "backend/*": ["../backend/dist/src/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
