{
	"extends": "@aria/tsconfig/next.json",
	"compilerOptions": {
		"noEmit": true,
		"baseUrl": ".",
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@/test/*": ["./test/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"test/**/*.ts",
		"test/**/*.tsx",
		"test/setup.ts",
		".next/types/**/*.ts"
	],
	"exclude": [
		"node_modules",
		".next",
		"dist",
		"coverage",
		"playwright-report",
		"test-results",
		"src/**/*.test.ts",
		"src/**/*.spec.ts"
	]
}
