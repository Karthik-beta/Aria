# Aria ERP Frontend - Production Environment Variables Template
# Copy this file to .env.production and fill in the values

# =============================================================================
# NEXT.JS CONFIGURATION
# =============================================================================

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Running in Docker
DOCKER_ENV=true

# Application version
NEXT_PUBLIC_VERSION=1.0.0

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL (internal Docker network)
NEXT_SERVER_API_URL=http://backend:3000

# Public API URL (browser-facing)
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# API timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# =============================================================================
# AUTHENTICATION
# =============================================================================

# NextAuth URL (public URL of your application)
NEXTAUTH_URL=https://your-domain.com

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# Zitadel Configuration
# Official docs: https://zitadel.com/docs/sdk-examples/nextjs
ZITADEL_DOMAIN=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=your-client-id-from-zitadel-console
ZITADEL_CLIENT_SECRET=your-client-secret-from-zitadel-console
ZITADEL_REDIRECT_URI=https://your-domain.com/api/auth/callback/zitadel
ZITADEL_POST_LOGOUT_URL=https://your-domain.com

# Default User Configuration (for initial deployment)
DEFAULT_USER_EMAIL=admin@your-domain.com
DEFAULT_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DEFAULT_USER_FIRSTNAME=Admin
DEFAULT_USER_LASTNAME=User

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Sentry DSN for error tracking (public)
NEXT_PUBLIC_SENTRY_DSN=https://your-public-sentry-key@sentry.io/project-id

# Sentry environment
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Sentry release
NEXT_PUBLIC_SENTRY_RELEASE=${NEXT_PUBLIC_VERSION}

# Sentry traces sample rate (0.0 to 1.0)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry replays session sample rate
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1

# Sentry replays on error sample rate
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Sentry auth token used by Next.js build step for releases and source map upload.
# Keep this server-side only (no NEXT_PUBLIC_ prefix).
SENTRY_AUTH_TOKEN=CHANGE_ME_SENTRY_AUTH_TOKEN
SENTRY_ORG=CHANGE_ME_SENTRY_ORG
SENTRY_PROJECT=CHANGE_ME_SENTRY_PROJECT

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable debug mode
NEXT_PUBLIC_DEBUG_MODE=false

# Enable analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Enable service worker
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true

# =============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# =============================================================================

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Maps API key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Default language
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supported locales (comma-separated)
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr

# Date format
NEXT_PUBLIC_DATE_FORMAT=MM/DD/YYYY

# Currency
NEXT_PUBLIC_CURRENCY=USD

# Timezone
NEXT_PUBLIC_TIMEZONE=America/New_York

# =============================================================================
# PERFORMANCE
# =============================================================================

# Enable image optimization
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# Image domains (comma-separated)
NEXT_PUBLIC_IMAGE_DOMAINS=your-domain.com,cdn.your-domain.com

# =============================================================================
# SECURITY
# =============================================================================

# Content Security Policy nonce (generated per request)
CSP_NONCE=

# =============================================================================
# BUILD-TIME VARIABLES (Set by CI/CD)
# =============================================================================

# Build ID
BUILD_ID=

# Git commit SHA
GIT_COMMIT_SHA=

# Build timestamp
BUILD_TIMESTAMP=

# =============================================================================
# NOTES
# =============================================================================
#
# PUBLIC vs. SERVER VARIABLES:
# - Variables with NEXT_PUBLIC_ prefix are exposed to the browser
# - Variables without prefix are server-only
# - Never put secrets in NEXT_PUBLIC_ variables
#
# SECURITY:
# 1. NEVER commit real secrets to version control
# 2. Use different values for each environment
# 3. Rotate secrets regularly
# 4. Validate all required variables at build time
#
# DEPLOYMENT:
# 1. Copy this template to .env.production
# 2. Fill in all CHANGE_ME values
# 3. Ensure .env.production is in .gitignore
# 4. Use secrets management in CI/CD
#
