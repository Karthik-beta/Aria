{
	"name": "@aria/utils",
	"version": "0.1.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --build --watch --preserveWatchOutput",
		"watch": "tsc --build --watch",
		"typecheck": "tsc --noEmit --pretty false",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"clean": "rimraf .turbo dist *.tsbuildinfo"
	},
	"dependencies": {
		"@aria/types": "workspace:*"
	},
	"devDependencies": {
		"@aria/tsconfig": "workspace:*",
		"@types/node": "^24.8.1",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3"
	}
}
