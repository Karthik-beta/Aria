{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"outDir": "./dist",
		"rootDir": "./src",
		"composite": true,
		"useUnknownInCatchVariables": false,
		"types": ["node"]
	},
	"references": [{ "path": "../../apps/backend/tsconfig.public-types.json" }],
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
