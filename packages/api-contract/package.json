{
	"name": "@aria/api-contract",
	"version": "0.1.0",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc --noEmit --pretty false",
		"dev": "tsc --noEmit --watch --preserveWatchOutput --pretty false",
		"watch": "tsc --noEmit --watch --preserveWatchOutput --pretty false",
		"typecheck": "tsc --noEmit --pretty false",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"clean": "rimraf .turbo dist *.tsbuildinfo"
	},
	"dependencies": {
		"@aria/types": "workspace:*",
		"@prisma/client": "^7.2.0",
		"@trpc/server": "^11.8.1"
	},
	"devDependencies": {
		"@aria/tsconfig": "workspace:*",
		"@types/node": "^25.0.3",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3"
	}
}
