{
	"name": "@aria/api-contract",
	"version": "0.1.0",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --build",
		"watch": "tsc --build --watch",
		"typecheck": "tsc -p ../../apps/backend/tsconfig.public-types.json --pretty false && tsc --noEmit --pretty false",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"clean": "rimraf .turbo dist *.tsbuildinfo"
	},
	"dependencies": {
		"backend": "workspace:*"
	},
	"devDependencies": {
		"@aria/tsconfig": "workspace:*",
		"rimraf": "^6.0.1",
		"typescript": "^5.9.3"
	}
}
